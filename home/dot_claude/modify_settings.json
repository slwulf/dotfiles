#!/bin/bash
content=$(cat)
[[ -z "$content" ]] && content="{}"
echo "$content" | jq '
  .statusLine = {"type": "command", "command": "bash ~/.claude/statusline-command.sh"} |
  .theme = "dark-ansi" |
  .preferredNotifChannel = "notifications_disabled" |
  .permissions = {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * show*)",
      "Bash(git -C * branch*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * remote*)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(which *)",
      "Bash(env *)",
      "Bash(pwd *)",
      "Bash(tree *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(ps *)",
      "Bash(echo *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(jq *)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(diff *)"
    ]
  }
'
